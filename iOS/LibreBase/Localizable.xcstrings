    "Stand still until your weight settles, then step off. LibreBase is recording how your scale communicates — lines captured so far: %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib still stehen, bis sich dein Gewicht eingependelt hat, und steig dann ab. LibreBase zeichnet auf, wie deine Waage kommuniziert — bisher aufgezeichnete Zeilen: %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quédate quieto hasta que el peso se estabilice y luego bájate. LibreBase está registrando cómo se comunica tu báscula; líneas registradas hasta ahora: %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez immobile jusqu’à ce que votre poids se stabilise, puis descendez. LibreBase enregistre la façon dont votre balance communique — lignes enregistrées jusqu’ici : %lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf stilstaan tot je gewicht stabiel is en stap dan af. LibreBase legt vast hoe je weegschaal communiceert — tot nu toe vastgelegde regels: %lld."
          }
        }
      }
    },
    "Start diagnostic capture": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnoseaufzeichnung starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar captura de diagnóstico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer la capture de diagnostic"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start diagnose-opname"
          }
        }
      }
    },
    "Start the capture, then step on your scale.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte die Aufzeichnung und stell dich dann auf die Waage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la captura y luego súbete a la báscula."
