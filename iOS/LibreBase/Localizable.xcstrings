    },
    "Weigh-in complete": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messung abgeschlossen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesaje completado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesée terminée"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weging voltooid"
          }
        }
      }
    },
    "Your QardioBase scale, back in your hands — and synced straight to Apple Health.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine QardioBase-Waage wieder in deiner Hand — und direkt mit Apple Health synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu báscula QardioBase de nuevo en tus manos, y sincronizada directamente con Apple Salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre balance QardioBase de nouveau entre vos mains — et synchronisée directement avec Apple Santé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je QardioBase-weegschaal weer in eigen handen — en meteen gesynchroniseerd met Apple Gezondheid."
          }
        }
      }
    },
    "Your weight appears the moment you step on the scale. Step off and you're done.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gewicht erscheint, sobald du auf der Waage stehst. Absteigen, fertig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso aparece en cuanto te subes a la báscula. Bájate y listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre poids s’affiche dès que vous montez sur la balance. Descendez, c’est terminé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gewicht verschijnt zodra je op de weegschaal staat. Stap eraf en je bent klaar."
          }
        }
      }
    },
    "Your weight will appear here automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gewicht erscheint hier automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso aparecerá aquí automáticamente."
          }
