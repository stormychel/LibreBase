    "Then send it over": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann schick es uns"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después envíanoslo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis envoyez-la-nous"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur het daarna op"
          }
        }
      }
    },
    "This records only your scale's Bluetooth data plus your device and app version — nothing else, and only while this screen is capturing. We use it solely to add support for your scale.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgezeichnet werden nur die Bluetooth-Daten deiner Waage sowie Gerät und App-Version — sonst nichts, und nur solange dieser Bildschirm aufzeichnet. Wir nutzen das ausschließlich, um deine Waage zu unterstützen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se registran los datos Bluetooth de tu báscula, además de tu dispositivo y la versión de la app; nada más, y solo mientras esta pantalla está capturando. Lo usamos únicamente para dar soporte a tu báscula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les données Bluetooth de votre balance, ainsi que votre appareil et la version de l’app, sont enregistrées — rien d’autre, et uniquement pendant la capture sur cet écran. Nous les utilisons uniquement pour ajouter la prise en charge de votre balance."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit legt alleen de Bluetooth-gegevens van je weegschaal vast, plus je toestel en appversie — verder niets, en alleen terwijl dit scherm opneemt. We gebruiken het uitsluitend om ondersteuning voor je weegschaal toe te voegen."
          }
        }
      }
    },
    "To find your QardioBase and read each weigh-in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deine QardioBase zu finden und jede Messung auszulesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para encontrar tu QardioBase y leer cada pesaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour trouver votre QardioBase et lire chaque pesée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om je QardioBase te vinden en elke weging uit te lezen."
          }
        }
      }
    },
    "To save your weight, and read your height for BMI.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dein Gewicht zu speichern und deine Größe für den BMI zu lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para guardar tu peso y leer tu altura para el IMC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer votre poids et lire votre taille pour l’IMC."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om je gewicht te bewaren en je lengte te lezen voor de BMI."
          }
        }
      }
    },
    "Underweight": {
      "localizations": {
        "de": {
          "stringUnit": {
