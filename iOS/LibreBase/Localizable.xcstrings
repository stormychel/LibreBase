    "Every weigh-in is written to Health, with in-app BMI from your height. Your data stays yours.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Messung landet in Health, mit BMI in der App anhand deiner Größe. Deine Daten bleiben deine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pesaje se guarda en Salud, con el IMC calculado en la app a partir de tu altura. Tus datos siguen siendo tuyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque pesée est enregistrée dans Santé, avec l’IMC calculé dans l’app à partir de votre taille. Vos données restent les vôtres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke weging komt in Gezondheid, met BMI in de app op basis van je lengte. Je gegevens blijven van jou."
          }
        }
      }
    },
